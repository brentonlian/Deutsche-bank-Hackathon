# Copy to .env.local and fill in. Never commit it.
# Which LLM adapter to use: gemini | ollama | openai
LLM_PROVIDER=gemini

# Gemini (Google AI Studio): https://aistudio.google.com/apikey
# Models are tried in order; the next one takes over when a free-tier quota runs out.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_API_KEY=

# Ollama (local), only if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:32b

# OpenAI, only if LLM_PROVIDER=openai
OPENAI_API_KEY=
